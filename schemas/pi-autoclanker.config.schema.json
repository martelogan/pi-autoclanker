{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pi-autoclanker config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "autoclankerBinary",
    "sessionRoot",
    "defaultIdeasMode"
  ],
  "properties": {
    "autoclankerBinary": {
      "type": "string",
      "minLength": 1
    },
    "sessionRoot": {
      "type": "string",
      "minLength": 1
    },
    "defaultIdeasMode": {
      "type": "string",
      "enum": ["rough", "canonicalize", "advanced_json"]
    },
    "autoclankerRepo": {
      "type": "string",
      "minLength": 1
    },
    "allowBilledLive": {
      "type": "boolean"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "evalCommand": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxIterations": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "runIntensity": {
      "type": "string",
      "enum": ["standard", "deep", "mega"]
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["interactive", "unattended", "headless"]
        },
        "clarificationPolicy": {
          "type": "string",
          "enum": ["allowed", "upfront_only", "never"]
        },
        "clarification_policy": {
          "type": "string",
          "enum": ["allowed", "upfront_only", "never"]
        },
        "targetWallTimeHours": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "target_wall_time_hours": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "minorRepairBudget": {
          "type": "integer",
          "minimum": 1
        },
        "minor_repair_budget": {
          "type": "integer",
          "minimum": 1
        },
        "selfDebugMinorIssues": {
          "type": "boolean"
        },
        "self_debug_minor_issues": {
          "type": "boolean"
        }
      }
    },
    "execution_policy": {
      "$ref": "#/properties/executionPolicy"
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
